# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
# COOKIE_SECURE=true           # defaults to true in production, false in development
INVITZ_DEMO_SEED=false         # set true only in local/demo environments to seed sample data

# --- Authentication (Auth.js v5: magic links + verified OAuth) ---
RESEND_API_KEY=                # magic-link e-mail provider (Resend)
EMAIL_FROM="Invitz <no-reply@invitz.app>"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# --- AI quality control (set ONE; without a key every link becomes "proceed with caution") ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=             # any OpenAI-compatible endpoint (Azure, Groq, Together, local vLLM...)
ANTHROPIC_API_KEY=
# QC_AI_PROVIDER=openai|anthropic
# QC_MODEL=gpt-4o-mini         # or e.g. claude-haiku-4-5 for anthropic
QC_VERIFY_THRESHOLD=0.75       # min AI confidence for a "Verified" label
QC_REJECT_THRESHOLD=0.85       # min AI confidence to auto-block as spam
QC_MAX_SHARES_PER_HOUR=10
INVITZ_BLOCKED_DOMAINS=        # comma-separated

# --- Notification channels & security (Phase 4 / 6 / 9) ---
NOTIFY_DRY_RUN=false           # true = never call external APIs (logs + marks deliveries as dry_run)
NOTIFY_USE_EXTERNAL_WORKER=false # true = enqueue jobs for `npm run worker` instead of immediate inline send
ENABLE_PG_LISTEN=false         # true = use Postgres LISTEN/NOTIFY across replicas for real-time bell updates
CRON_SECRET=                   # bearer secret for /api/cron/notifications scheduled digest sweep

# Column-level AES-256-GCM encryption & HMAC lookup (defaults derive from AUTH_SECRET if unset)
NOTIFICATION_ENCRYPTION_KEY=   # 32-byte hex or base64 key
# NOTIFICATION_ENCRYPTION_KEYS={"v1":"...","v2":"..."} # key rotation map
# NOTIFICATION_ACTIVE_KEY_ID=v1
# NOTIFICATION_LOOKUP_SECRET=

# Discord v2 bot interactions & channel subscriptions
DISCORD_PUBLIC_KEY=            # 64-char hex Ed25519 public key for /api/webhooks/discord
DISCORD_BOT_TOKEN=             # Discord bot token for /invitz community channel subscriptions

# Telegram bot & /start deep-link verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=       # secret sent in X-Telegram-Bot-Api-Secret-Token

# WhatsApp Meta Cloud API + webhook verification
WHATSAPP_TOKEN=                # Meta WhatsApp Cloud API permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=           # HMAC app secret for X-Hub-Signature-256 webhook verification
WHATSAPP_VERIFY_TOKEN=         # GET challenge verification token for /api/webhooks/whatsapp
WHATSAPP_TEMPLATE_NAME=        # approved utility template for invite notifications
WHATSAPP_VERIFY_TEMPLATE_NAME= # optional approved authentication/utility template for 6-digit OTPs
WHATSAPP_DIGEST_TEMPLATE_NAME= # optional utility template for digest batches
# WHATSAPP_TEMPLATE_MAP={"invite":"invitz_new_invite","verify":"invitz_verify_code","digest":"invitz_digest"}
WHATSAPP_TEMPLATE_LANG=en

# Signal (best-effort Beta)
SIGNAL_ENABLED=true            # set false as emergency kill switch
SIGNAL_API_URL=                # self-hosted signal-cli-rest-api, e.g. http://signal:8080
SIGNAL_SENDER=                 # registered Signal number, e.g. +4915112345678
SIGNAL_API_KEY=                # optional bearer token for signal-cli-rest-api reverse proxy
